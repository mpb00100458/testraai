# Helena Cruz Accessibility Platform - Production Environment Variables
# Copy this file to .env.production and fill in your values
# DO NOT commit .env.production to git!

# ============================================
# Application Settings
# ============================================
NODE_ENV=production
PORT=8080

# ============================================
# Database Configuration
# ============================================
# For Cloud SQL (Unix socket connection):
DATABASE_URL=postgresql://helena_user:YOUR_PASSWORD@/testraai?host=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME

# For Neon or external PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# ============================================
# Session Configuration
# ============================================
# Generate a secure random string (at least 32 characters)
# You can use: openssl rand -base64 32
SESSION_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING

# ============================================
# OpenAI API Configuration
# ============================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# ============================================
# Google Cloud Storage
# ============================================
# Bucket name for storing accessibility reports, videos, traces
PRIVATE_OBJECT_DIR=gs://helena-cruz-reports

# Your GCP Project ID
GCP_PROJECT_ID=your-gcp-project-id

# ============================================
# Application URLs
# ============================================
# Your Cloud Run service URL or custom domain
FRONTEND_URL=https://your-service-name.run.app
BACKEND_URL=https://your-service-name.run.app

# ============================================
# Optional: Model Context Protocol (MCP)
# ============================================
# If you're using MCP servers for AI agent tools
# MCP_SERVER_CONFIG=path/to/mcp-config.json

# ============================================
# Optional: Monitoring & Logging
# ============================================
# LOG_LEVEL=info
# ENABLE_DEBUG_LOGS=false

# ============================================
# Optional: Rate Limiting
# ============================================
# MAX_SCANS_PER_USER_PER_DAY=100
# MAX_CONCURRENT_SCANS=10

# ============================================
# Optional: Email Configuration (for notifications)
# ============================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAIL_FROM=noreply@your-domain.com

# ============================================
# Security Headers
# ============================================
# CORS_ORIGIN=https://your-domain.com
# ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

