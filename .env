# Agentium Environment Configuration

# ============================================
# DATABASE (REQUIRED)
# ============================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
# 
# For local PostgreSQL:
# DATABASE_URL=postgresql://localhost/agentium
#
# For Neon (cloud):
# DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/agentium?sslmode=require
#
DATABASE_URL=postgresql://localhost/testraai

# ============================================
# SESSION SECURITY (REQUIRED)
# ============================================
# Secret key for session encryption
# Generate a random string: openssl rand -base64 32
SESSION_SECRET=change-this-to-a-random-secret-key-for-production

# ============================================
# AI AGENT (REQUIRED for AI features)
# ============================================
# OpenAI API configuration for AI Agent chatbot
# Get your API key from: https://platform.openai.com/api-keys
#
# IMPORTANT: Replace the placeholder below with your actual OpenAI API key
# The AI Agent will NOT work without a valid API key
#
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_OPENAI_API_KEY=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

# ============================================
# OBJECT STORAGE (OPTIONAL)
# ============================================
# For storing scan videos and Playwright traces
# Leave empty to use local file storage
# REPLIT_OBJECT_STORAGE_URL=

# ============================================
# STRIPE BILLING (OPTIONAL)
# ============================================
# For subscription and payment features
# Get keys from: https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=sk_test_...
# VITE_STRIPE_PUBLIC_KEY=pk_test_...

# ============================================
# APPLICATION SETTINGS
# ============================================
# Node environment
NODE_ENV=development

# Server port (default: 5000)
# Using 3000 because macOS Control Center uses 5000
PORT=3000

